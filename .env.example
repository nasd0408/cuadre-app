# Copia este archivo como .env y completa los valores. .env no se sube al repo.

# URL de la API (https://github.com/nasd0408/cuadre-api).
# Con un teléfono físico (Expo Go o dev client) usa la IP LAN de tu PC, no
# localhost, y conecta el teléfono a la misma WiFi.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5002/api

# URL donde se sirve la versión web. Se usa para armar los enlaces de reserva
# pública. En web, si está vacía, se usa la URL actual del navegador.
EXPO_PUBLIC_WEB_URL=

# Client ID web de Google (OAuth). Sin él no aparece el botón
# "Continuar con Google".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Los IDs de AdMob no van aquí: en desarrollo siempre se usan los de prueba de
# Google, y los reales se inyectan en las builds desde eas.json.

# 1 = enviar eventos de Analytics también en desarrollo (para DebugView).
EXPO_PUBLIC_ANALYTICS_DEBUG=0
